{
  "name": "bubbleink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The shared widget library: ink-skinned Lit widgets that speak FieldBinding and render a snapshot. No domain knowledge -- keep it that way.",
  "exports": {
    "./widgets": "./src/widgets/index.ts",
    "./widgets/*": "./src/widgets/*.ts",
    "./core": "./src/core/index.ts",
    "./core/*": "./src/core/*.ts",
    "./theme": "./src/theme/index.ts",
    "./theme/*": "./src/theme/*",
    "./draw": "./src/draw/index.ts",
    "./draw/*": "./src/draw/*.ts",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools",
    "probe": "node tools/state-probe.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "chrome-remote-interface": "^0.34.0",
    "lit": "^3.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
